{
  "name": "pk-launcher-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "PK Launcher Discord bot (Production Node / discord.js)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
