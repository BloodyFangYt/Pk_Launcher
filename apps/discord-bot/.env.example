# Discord bot token (from the Developer Portal).
DISCORD_TOKEN=

# Application ID (needed to register global/application slash commands).
DISCORD_APPLICATION_ID=

# Base URL of the central PK Launcher backend without a trailing slash,
# e.g. https://api.pklauncher.app . The client appends /api/v1/bot/...
BOT_API_URL=http://localhost:8080

# Optional: Discord guild ID to register commands instantly (guild-scoped).
# Leave empty to register application-wide (global, up to 1h to propagate).
DISCORD_GUILD_ID=